# Shelf-J — example environment. Copy to .env and adjust. NEVER commit .env.
# Secrets (DB passwords, JWT keys, payment keys) live here / in your secret store — not in code or images.

# --- Postgres (one DB; each service uses its own schema + its own role — see
# infra/postgres-init-roles.sql) ---
# POSTGRES_USER/PASSWORD remain the bootstrap/admin role (runs the role-provisioning
# script, owns ops/backup access). No business service connects as this role.
POSTGRES_DB=shelfj
POSTGRES_USER=shelfj
POSTGRES_PASSWORD=shelfj_dev_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Per-service Postgres roles (infra/postgres-init-roles.sql GRANTs each role only
# its own schema). Changing a password here also means updating: the matching line in
# infra/postgres-init-roles.sql, the matching line in infra/pgbouncer-userlist.txt, and
# re-running the roles script against the live DB (see header comment in that file).
IAM_DB_PASSWORD=iam_dev_change_me
TENANT_DB_PASSWORD=tenant_dev_change_me
PRODUCT_DB_PASSWORD=product_dev_change_me
INVENTORY_DB_PASSWORD=inventory_dev_change_me
PURCHASE_DB_PASSWORD=purchase_dev_change_me
PRICING_DB_PASSWORD=pricing_dev_change_me
CART_DB_PASSWORD=cart_dev_change_me
ORDER_DB_PASSWORD=order_dev_change_me
PAYMENT_DB_PASSWORD=payment_dev_change_me
CUSTOMER_DB_PASSWORD=customer_dev_change_me
NOTIFICATION_DB_PASSWORD=notification_dev_change_me
REPORTING_DB_PASSWORD=reporting_dev_change_me

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Consul (service discovery) ---
CONSUL_HOST=localhost
CONSUL_PORT=8500

# --- Config service ---
CONFIG_SERVER_URL=http://localhost:8888
# Shared token — every service sends this in X-Config-Token when calling config-svc.
# Must be >= 32 chars. Generate with: openssl rand -base64 48
SHELFJ_CONFIG_TOKEN=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_change_me

# --- Tracing ---
ZIPKIN_URL=http://localhost:9411/api/v2/spans

# --- JWT (Phase 0 uses a dev signing secret; production uses RS256 keys from a secret store) ---
# SHELFJ_JWT_SECRET feeds shelfj.jwt.secret in iam-svc and the gateway (must match).
# REQUIRED to be >= 32 characters — services refuse to start otherwise.
# Generate your own (never commit it):  openssl rand -base64 48
JWT_ISSUER=shelfj
SHELFJ_JWT_SECRET=

# --- Platform admin bootstrap (one-shot; the bootstrap endpoint 409s once an admin exists) ---
# REQUIRED — no default. A known default password would mean every fresh deploy ships
# with a publicly-known PLATFORM_ADMIN superuser credential. Generate your own:
# openssl rand -base64 24
PLATFORM_ADMIN_EMAIL=admin@shelf-j.dev
PLATFORM_ADMIN_PASSWORD=

# --- Server-side pricing (gap #63) ---
# When true, order-svc resolves unit prices (and tax) from pricing-svc and ignores
# client-supplied prices/tax/discount. Defaults to true (secure) — a client that can
# name its own price is a direct fraud vector, tenant scoping aside. Set to false only
# for local dev/demo with an unseeded price catalogue; order-svc logs a WARNING at
# startup whenever this is false as a reminder. Production MUST be true.
SHELFJ_ORDER_PRICING_ENFORCE=true

# --- JVM heap caps (applied via JAVA_TOOL_OPTIONS / KAFKA_HEAP_OPTS) ---
# Defaults below target an 8 vCPU / 16 GB VPS.
# For 8 GB VPS (minimum): halve Xmx values, set Kafka to -Xms256m -Xmx512m.
# For 32 GB VPS (full load): double Xmx values, set Kafka to -Xms1g -Xmx2g.
GATEWAY_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
CONFIG_JAVA_OPTS=-Xms64m -Xmx256m -XX:+UseG1GC
IAM_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
TENANT_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
INVENTORY_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
PRODUCT_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
ORDER_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
PURCHASE_JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseG1GC
PRICING_JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseG1GC
KAFKA_HEAP_OPTS=-Xms512m -Xmx1g
ZIPKIN_JAVA_OPTS=-Xms128m -Xmx512m
KAFKA_UI_JAVA_OPTS=-Xms128m -Xmx384m

# --- Docker memory hard limits (enforced via mem_limit; prevents OOM-killing the host) ---
# This file lists the tunable subset; several services take their mem_limit default straight from
# docker-compose.yml and are not repeated here. Summed across ALL capped containers the ceiling is
# ~12.6 GB, leaving ~3.4 GB on a 16 GB host for the OS and for postgres, which is deliberately
# uncapped (it manages its own shared_buffers/work_mem — see the PG tuning block below).
GATEWAY_MEM_LIMIT=700m
CONFIG_MEM_LIMIT=384m
IAM_MEM_LIMIT=700m
TENANT_MEM_LIMIT=700m
INVENTORY_MEM_LIMIT=700m
PRODUCT_MEM_LIMIT=700m
ORDER_MEM_LIMIT=700m
PURCHASE_MEM_LIMIT=512m
PRICING_MEM_LIMIT=512m
KAFKA_MEM_LIMIT=1300m
KAFKA_UI_MEM_LIMIT=550m
ZIPKIN_MEM_LIMIT=700m
PROMETHEUS_MEM_LIMIT=512m
LOKI_MEM_LIMIT=512m
TEMPO_MEM_LIMIT=512m
# Raising this? Raise memory_limiter.limit_mib (~80% of it) and GOMEMLIMIT in
# infra/otel-collector-config.yaml and docker-compose.yml to match, or the container gets
# OOM-killed before the collector can shed load.
OTEL_COLLECTOR_MEM_LIMIT=512m

# --- PostgreSQL tuning (override defaults in docker-compose command section) ---
# For 16 GB VPS recommended values:
# PG_SHARED_BUFFERS=2GB          (25% of RAM)
# PG_EFFECTIVE_CACHE_SIZE=8GB    (50% of RAM)
# PG_WORK_MEM=32MB
# PG_MAINTENANCE_WORK_MEM=256MB
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=8GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=256MB

# --- Production domain (storeql.com) ----------------------------------------
# Used by docker-compose.prod.yml and the GitHub Actions docker-publish workflow.
#
# 1. DNS — add these A records at your registrar before first deploy:
#      app.storeql.com  →  <your-server-public-ip>
#      api.storeql.com  →  <your-server-public-ip>
#      storeql.com      →  <your-server-public-ip>
#
# 2. Caddy (infra/Caddyfile) handles TLS automatically via Let's Encrypt.
#    Set this email so Let's Encrypt can notify you about cert expiry:
CADDY_ACME_EMAIL=ops@storeql.com
#
# 3. Set the gateway URL as a GitHub Actions repository variable
#    (Settings → Secrets and variables → Actions → Variables):
#      SHELFJ_API_BASE = https://api.storeql.com/api
#    This is baked into the Flutter web bundle at CI build time.
#
# 4. Start the production stack:
#    docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# --- Toolchain note ---
# Build with JDK 21:  export JAVA_HOME=/usr/lib/jvm/temurin-21-jdk-amd64
