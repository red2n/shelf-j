      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-shelfj" },
          "expr": "jvm_uptime_seconds{job=~\"$service\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
