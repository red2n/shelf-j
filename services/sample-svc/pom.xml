<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shelfj</groupId>
        <artifactId>shelf-j-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>sample-svc</artifactId>
    <name>Shelf-J :: services :: sample-svc</name>
    <description>
        Reference TEMPLATE service. Proves the Shelf-J service shape end-to-end:
        layered packages, response envelope, tenant context, 3 health probes (ready checks the DB),
        Flyway migration, /metrics, and Consul self-registration. The scaffold-service skill copies this.
        NOTE: uses plain JDBC + Flyway for Phase 0; real services add JPA per the scaffold-service skill.
    </description>

    <properties>
        <!-- Use Helidon's own launcher (auto-wires CDI + observability routing). Do NOT use a custom main. -->
        <mainClass>io.helidon.Main</mainClass>
    </properties>

    <dependencies>
        <!-- Slim MicroProfile core: CDI + JAX-RS server + Config (the documented quickstart base). -->
        <dependency>
            <groupId>io.helidon.microprofile.bundles</groupId>
            <artifactId>helidon-microprofile-core</artifactId>
        </dependency>
        <!-- Health (liveness/readiness/startup probes at /health/*) -->
        <dependency>
            <groupId>io.helidon.microprofile.health</groupId>
            <artifactId>helidon-microprofile-health</artifactId>
        </dependency>
        <!-- Metrics (/metrics) -->
        <dependency>
            <groupId>io.helidon.microprofile.metrics</groupId>
            <artifactId>helidon-microprofile-metrics</artifactId>
        </dependency>
        <!-- JUL logging backend (quickstart uses this) -->
        <dependency>
            <groupId>io.helidon.logging</groupId>
            <artifactId>helidon-logging-jul</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- WebClient — used to self-register with the Consul HTTP API -->
        <dependency>
            <groupId>io.helidon.webclient</groupId>
            <artifactId>helidon-webclient</artifactId>
        </dependency>

        <!-- JSON-B media so JAX-RS can (de)serialize our DTO records. The slim core bundle ships JSON-P only. -->
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-json-binding</artifactId>
            <version>3.1.11</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse</groupId>
            <artifactId>yasson</artifactId>
            <version>3.0.4</version>
        </dependency>

        <!-- Shared Shelf-J modules -->
        <dependency>
            <groupId>com.shelfj</groupId>
            <artifactId>common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shelfj</groupId>
            <artifactId>common-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shelfj</groupId>
            <artifactId>events-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shelfj</groupId>
            <artifactId>discovery</artifactId>
            <version>${shelfj.version}</version>
        </dependency>

        <!-- Persistence: plain JDBC + Flyway (Phase 0 template) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>com.shelfj</groupId>
            <artifactId>common-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.microprofile.testing</groupId>
            <artifactId>helidon-microprofile-testing-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- hamcrest comes transitively via helidon-microprofile-testing-junit5 -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>2.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>sample-svc</finalName>
        <plugins>
            <!--
              Runnable jar: the Helidon parent already sets the jar manifest Main-Class +
              Class-Path: libs/*.  We copy the runtime dependencies into target/libs/ so
              `java -jar target/sample-svc.jar` works.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
