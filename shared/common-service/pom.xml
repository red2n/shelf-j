<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shelfj</groupId>
        <artifactId>shelf-j-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-service</artifactId>
    <name>Shelf-J :: shared :: common-service</name>
    <description>
        Reusable service infrastructure (no business logic): DataSource producer, Flyway runner, Consul
        registration, health checks, and the Kafka outbox publisher. A service provides a ServiceSettings bean and
        an OutboxStore; the shared beans do the rest. Eliminates the per-service boilerplate Duplo flagged.
    </description>

    <dependencies>
        <!-- Web utilities: ApiException, ApiResponse, TenantContext, etc. -->
        <dependency>
            <groupId>com.shelfj</groupId>
            <artifactId>common-web</artifactId>
            <version>${shelfj.version}</version>
        </dependency>

        <!-- Discovery (ConsulClient) -->
        <dependency>
            <groupId>com.shelfj</groupId>
            <artifactId>discovery</artifactId>
            <version>${shelfj.version}</version>
        </dependency>

        <!-- CDI / config / health APIs — provided by the host service's Helidon runtime -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.health</groupId>
            <artifactId>microprofile-health-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- DB + migrations + Kafka — provided (host service brings the runtime versions) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Connection pool — compile scope on purpose: flows transitively to every service so the
             pool is always present (version pinned in the parent). -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <!-- Redis client for the shared cache-aside producer — compile scope, same reasoning as
             HikariCP above: present in every service, only actually connected by services that
             inject RedisCommands (version pinned in the parent). -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.7.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- JSON-P — provided by the Helidon MP runtime; declared here so the shared
             status-changed handler classes can use Jakarta JSON APIs. -->
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JSON-P implementation for tests only (the -api above is provided at runtime by the host
             service's Helidon runtime; a unit test that parses a config-svc response needs a real
             provider on the test classpath). Version matches Helidon 4.4.1's jakarta.json-api 2.1.3. -->
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>1.1.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
