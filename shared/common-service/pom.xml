<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shelfj</groupId>
        <artifactId>shelf-j-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-service</artifactId>
    <name>Shelf-J :: shared :: common-service</name>
    <description>
        Reusable service infrastructure (no business logic): DataSource producer, Flyway runner, Consul
        registration, health checks, and the Kafka outbox publisher. A service provides a ServiceSettings bean and
        an OutboxStore; the shared beans do the rest. Eliminates the per-service boilerplate Duplo flagged.
    </description>

    <dependencies>
        <!-- Web utilities: ApiException, ApiResponse, TenantContext, etc. -->
        <dependency>
            <groupId>com.shelfj</groupId>
            <artifactId>common-web</artifactId>
            <version>${shelfj.version}</version>
        </dependency>

        <!-- Discovery (ConsulClient) -->
        <dependency>
            <groupId>com.shelfj</groupId>
            <artifactId>discovery</artifactId>
            <version>${shelfj.version}</version>
        </dependency>

        <!-- CDI / config / health APIs — provided by the host service's Helidon runtime -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.health</groupId>
            <artifactId>microprofile-health-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- DB + migrations + Kafka — provided (host service brings the runtime versions) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.7.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
